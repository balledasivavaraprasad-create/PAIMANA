PROJECT_NAME="PAIMANA AI Decision-Support Platform"
API_V1_STR="/api/v1"
SECRET_KEY="paimana-super-secret-production-grade-security-token-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="paimana_intelligence"

# Environmental & GIS
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_ELEVATION_BASE_URL="https://api.open-meteo.com/v1/elevation"

# Alerting & Webhooks
N8N_WEBHOOK_URL="http://localhost:5678/webhook/paimana-risk-alert"
ALERT_COOLDOWN_HOURS=24

# LLM Agent & Reasoning
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
LLM_MODEL="gemini-2.0-flash"
